    {
      "id": "ie9dHaBfmiZtMe5_9ONic",
      "type": "text",
      "x": 332.89211283185796,
      "y": 204.05260834952082,
      "width": 688.299560546875,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
