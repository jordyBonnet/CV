    {
      "id": "VsQDnLLnOxFZDKZdhizuK",
      "type": "text",
      "x": -1242.2825344418409,
      "y": 169.07020122679978,
      "width": 604.299560546875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0y",
      "roundness": null,
      "seed": 1346153593,
      "version": 3422,
      "versionNonce": 1202458239,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786029838792,
      "link": null,
      "locked": false,
      "text": "Évaluation et sélection d’un modèle d’arbres de décision\n(XGBoost) et d’un modèle de deep learning (TensorFlow) pour\naccélérer la synthèse de formules de tensioactifs, pour le\nmarché de l’Enhanced Oil Recovery. Un sujet de\nchemoinformatique s’appuyant principalement sur les SMILES\ndes molécules et les paramètres de procédé qui permet de\ncibler rapidement une salinité optimale pour les nouveaux\ncontrats entrants. L’outil final a été mis en production sur la\nplateforme Dataiku.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "GHzwQxqWo9MxdfcY2hRgJ",
      "originalText": "Évaluation et sélection d’un modèle d’arbres de décision (XGBoost) et d’un modèle de deep learning (TensorFlow) pour accélérer la synthèse de formules de tensioactifs, pour le marché de l’Enhanced Oil Recovery. Un sujet de chemoinformatique s’appuyant principalement sur les SMILES des molécules et les paramètres de procédé qui permet de cibler rapidement une salinité optimale pour les nouveaux contrats entrants. L’outil final a été mis en production sur la plateforme Dataiku.",
      "autoResize": true,
      "lineHeight": 1.25
    },
